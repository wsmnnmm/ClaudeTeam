# Keep the build context small + reproducible.

# Local debris
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/

# Tests + docs aren't needed inside the runtime image; devs who want
# them bind-mount the repo at /app.
tests/
projects/
workspace/
# Ignore everything under scripts/ EXCEPT the feishu_channel sidecar, which
# the Dockerfile COPYs + bakes (event ingress + `feishu connect` registration).
# Its node_modules is rebuilt in-image, so keep it out of the context.
scripts/*
!scripts/feishu_channel
scripts/feishu_channel/node_modules

# Per-deployment state — never bake into an image
state/
team-data/
*.pid
*.cursor

# Editor / VCS / OS clutter
.git/
.github/
.vscode/
.idea/
.DS_Store

# Local team config from the host shouldn't leak into images
team.json
runtime_config.json
.claude/
